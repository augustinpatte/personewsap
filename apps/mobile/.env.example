# Copy this file to apps/mobile/.env for local Expo development.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Do not put service role keys, Resend keys, or generation secrets here.

# Supabase Project URL, for example:
# EXPO_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public API key from Project Settings > API.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: during live proof runs, mock fallback logs are emitted as console errors.
EXPO_PUBLIC_LIVE_DATA_PROOF_MODE=false

# Optional for local development, required before registering physical-device Expo push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional: account/support contact shown in the mobile Support screen.
EXPO_PUBLIC_SUPPORT_EMAIL=support@personewsap.com

# Optional product analytics. Leave blank to no-op safely.
# Use only public/client-safe analytics keys here.
EXPO_PUBLIC_ANALYTICS_PROVIDER=
EXPO_PUBLIC_ANALYTICS_ENDPOINT=
EXPO_PUBLIC_ANALYTICS_WRITE_KEY=
EXPO_PUBLIC_ANALYTICS_DEBUG=false

# Account deletion endpoint (Supabase Edge Function). Required before store
# submission: the Account screen refuses to delete without it.
# Deploy with: supabase functions deploy delete-account
# EXPO_PUBLIC_ACCOUNT_DELETION_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/delete-account
EXPO_PUBLIC_ACCOUNT_DELETION_ENDPOINT=

# Optional: allow sample content in a build connected to a real Supabase
# project. Off by default, and it must stay off for anything a reader sees.
EXPO_PUBLIC_ALLOW_MOCK_CONTENT=false
