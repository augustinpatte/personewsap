{
  "expo": {
    "name": "PersoNewsAP",
    "slug": "personewsap-mobile",
    "scheme": "personewsap",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F1E8",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F5F1E8",
      "resizeMode": "contain"
    },
    "ios": {
      "buildNumber": "11",
      "supportsTablet": false,
      "bundleIdentifier": "com.personewsap.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "backgroundColor": "#F5F1E8",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#16140F",
          "resizeMode": "contain"
        }
      }
    },
    "android": {
      "package": "com.personewsap.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F5F1E8"
      },
      "splash": {
        "backgroundColor": "#F5F1E8",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#16140F",
          "resizeMode": "contain"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F5B5F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PersoNewsAP uses your photo library only when you choose a player photo for a Team leaderboard.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30f70b52-4540-465a-88d7-c0b0b428c082"
      }
    },
    "owner": "augustinpatte",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/30f70b52-4540-465a-88d7-c0b0b428c082"
    }
  }
}
