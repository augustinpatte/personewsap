# Copy to services/content-engine/.env for local content-engine commands.
# This file is server-side only. Never copy SUPABASE_SERVICE_ROLE_KEY into
# apps/mobile/.env, Vite env files, Expo public env vars, or client code.

# Required for read-only diagnostics and any persistence/write test command.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required only when intentionally running npm run content:daily-job-test:local.
# Keep false until you are ready to write marked test content/daily drops.
CONFIRM_DAILY_JOB_TEST=false

# Safe local defaults for daily-job-test/debug-users.
LANGUAGES=en
USER_LIMIT=3
CONTENT_STATUS=published
USE_LLM=false
LIVE_RSS=false
LIVE_RSS_ONLY=false
RSS_ARTICLES_PER_SOURCE=1

# Optional LLM/live-source settings. Do not set provider keys unless USE_LLM=true.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEWSLETTER_MODEL=gpt-5-mini-2025-08-07
NEWSLETTER_REASONING_EFFORT=none
NEWSLETTER_FALLBACK_MODEL=gpt-5.4-mini-2026-03-17
MINI_CASE_MODEL=gpt-5.4-mini-2026-03-17
MINI_CASE_REASONING_EFFORT=low
MINI_CASE_FALLBACK_MODEL=gpt-5.4-2026-03-05
BUSINESS_STORY_PROVIDER=anthropic
BUSINESS_STORY_MODEL=claude-sonnet-4-6
BUSINESS_STORY_FALLBACK_PROVIDER=openai
BUSINESS_STORY_FALLBACK_MODEL=gpt-5.4-2026-03-05
LEARNING_GENERATION_MODE=deterministic
# Legacy local override still supported by older tests/tools when a section-specific model is not set.
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=120000
ANTHROPIC_REQUEST_TIMEOUT_MS=120000
OPENAI_LEARNING_MODEL=
LEARNING_GENERATION_MAX_ATTEMPTS=3
LEARNING_GENERATION_CONCURRENCY=3
