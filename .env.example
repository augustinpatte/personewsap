# Public web app (Vite). Copy to .env for local development.
# Only VITE_-prefixed variables reach the browser bundle. Never put a Supabase
# service-role key here: it belongs exclusively in the delete-account Edge
# Function.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Same Edge Function the mobile app calls. Powers /delete-account, the external
# account-deletion URL required by Google Play.
VITE_ACCOUNT_DELETION_ENDPOINT=
